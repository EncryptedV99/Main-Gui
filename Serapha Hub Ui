local function formatTime(seconds)
	seconds = math.floor(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor(seconds % 3600 / 60)
	local remaining = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, remaining)
	end
	return string.format("%d:%02d", minutes, remaining)
end
local function getGreeting()
	local hour = os.date("*t").hour
	if hour >= 5 and hour < 12 then
		return "Good morning"
	elseif hour >= 12 and hour < 18 then
		return "Good afternoon"
	end
	return "Good evening"
end
local function hueFromX(x)
	for index = 1, # HUE_STOPS - 1 do
		local from = HUE_STOPS[index]
		local to = HUE_STOPS[index + 1]
		if x <= to[1] then
			local alpha = (x - from[1]) / (to[1] - from[1])
			return from[2] + (to[2] - from[2]) * alpha
		end
	end
	return HUE_STOPS[# HUE_STOPS][2]
end
local function xFromHue(hue)
	local first = HUE_STOPS[1]
	local last = HUE_STOPS[# HUE_STOPS]
	if hue >= first[2] then
		return 0
	end
	if hue <= last[2] then
		local distanceToLast = last[2] - hue
		local distanceToFirst = hue + 1 - first[2]
		return distanceToFirst < distanceToLast and 0 or 1
	end
	for index = 1, # HUE_STOPS - 1 do
		local from = HUE_STOPS[index]
		local to = HUE_STOPS[index + 1]
		if hue <= from[2] and hue >= to[2] then
			local alpha = (hue - from[2]) / (to[2] - from[2])
			return from[1] + (to[1] - from[1]) * alpha
		end
	end
	return 0
end
local function applyTheme(name, animate)
	local palette = Themes[name]
	if not palette then
		return
	end
	currentThemeName = name
	for key, value in pairs(palette) do
		Colors[key] = value
	end
	if transparencyOverride then
		Colors.WindowTransparency = transparencyOverride
		Colors.ItemTransparency = transparencyOverride
	end
	for _, instance in ipairs(gui:GetDescendants()) do
		for attribute, key in pairs(instance:GetAttributes()) do
			if attribute:sub(1, 5) == "Theme" and type(key) == "string" and Colors[key] ~= nil then
				local property = attribute:sub(6)
				if animate then
					tween(instance, 0.3, {
						[property] = Colors[key]
					})
				else
					instance[property] = Colors[key]
				end
			end
		end
	end
end
local function applyTransparency(value)
	transparencyOverride = math.clamp(value, 0, 0.95)
	Colors.WindowTransparency = transparencyOverride
	Colors.ItemTransparency = transparencyOverride
	for _, instance in ipairs(gui:GetDescendants()) do
		local key = instance:GetAttribute("ThemeBackgroundTransparency")
		if key and Colors[key] ~= nil then
			instance.BackgroundTransparency = Colors[key]
		end
	end
end
local function applyFont(name)
	local family = Fonts[name]
	if not family then
		return
	end
	currentFontName = name
	currentFont = Font.new(family, Enum.FontWeight.Bold)
	for _, instance in ipairs(gui:GetDescendants()) do
		if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
			instance.FontFace = currentFont
		end
	end
end
local function getFadeProperties(instance)
	local properties = {}
	if instance:IsA("GuiObject") then
		table.insert(properties, "BackgroundTransparency")
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		table.insert(properties, "TextTransparency")
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		table.insert(properties, "ImageTransparency")
	end
	if instance:IsA("ScrollingFrame") then
		table.insert(properties, "ScrollBarImageTransparency")
	end
	if instance:IsA("UIStroke") then
		table.insert(properties, "Transparency")
	end
	return properties
end
local function captureFade(root)
	local snapshot = {}
	local instances = root:GetDescendants()
	table.insert(instances, root)
	for _, instance in ipairs(instances) do
		for _, property in ipairs(getFadeProperties(instance)) do
			local current = instance[property]
			if current < 1 then
				local restore = current
				if property == "BackgroundTransparency" and instance:GetAttribute("RestTransparency") then
					restore = instance:GetAttribute("RestTransparency")
				end
				table.insert(snapshot, {
					instance,
					property,
					restore
				})
			end
		end
	end
	return snapshot
end
local function playFade(snapshot, visible, duration, style, direction)
	for _, entry in ipairs(snapshot) do
		local instance, property, value = entry[1], entry[2], entry[3]
		if instance.Parent then
			tween(instance, duration, {
				[property] = visible and value or 1
			}, style, direction)
		end
	end
end
