local function addHover(frame, button, isLocked)
	frame:SetAttribute("RestTransparency", 1)
	if IS_TOUCH then
		return
	end
	button.MouseEnter:Connect(function()
		if isLocked and isLocked() then
			return
		end
		tween(frame, 0.12, {
			BackgroundTransparency = 0.5
		})
	end)
	button.MouseLeave:Connect(function()
		tween(frame, 0.12, {
			BackgroundTransparency = 1
		})
	end)
end
