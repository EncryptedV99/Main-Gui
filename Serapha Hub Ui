		})
		corner(box, 6)
		stroke(box)
		local minusButton = create("TextButton", {
			Text = "–",
			FontFace = currentFont,
			TextSize = 15,
			TextColor3 = Theme.Text,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(30, 28),
			ZIndex = 2,
			Parent = box,
		})
		local plusButton = create("TextButton", {
			Text = "+",
			FontFace = currentFont,
			TextSize = 15,
			TextColor3 = Theme.Text,
			BackgroundTransparency = 1,
			Position = UDim2.new(1, - 30, 0, 0),
			Size = UDim2.fromOffset(30, 28),
			ZIndex = 2,
			Parent = box,
		})
		line(box, UDim2.fromOffset(1, 16), UDim2.new(0, 30, 0.5, - 8))
		line(box, UDim2.fromOffset(1, 16), UDim2.new(1, - 31, 0.5, - 8))
		local valueLabel = label(box, "", 12, "Text", {
			Position = UDim2.fromOffset(31, 0),
			Size = UDim2.new(1, - 62, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local function setValue(newValue, shouldFire)
			newValue = math.clamp(newValue, min, max)
			newValue = min + math.floor((newValue - min) / step + 0.5) * step
			newValue = math.clamp(tonumber(string.format("%." .. decimals .. "f", newValue)), min, max)
			local changed = newValue ~= value
			value = newValue
			valueLabel.Text = string.format("%." .. decimals .. "f", value) .. suffix
			tweenTheme(minusButton, 0.15, "TextColor3", value <= min and "SubText" or "Text")
			tweenTheme(plusButton, 0.15, "TextColor3", value >= max and "SubText" or "Text")
			if shouldFire and changed then
				fire(config.Callback, value)
			end
		end
		setValue(config.Default or min, false)
		local function bindRepeat(button, direction)
			local holding = false
			local holdToken = 0
			button.InputBegan:Connect(function(input)
				if not isPress(input) then
					return
				end
				holding = true
				holdToken += 1
				local token = holdToken
				setValue(value + step * direction, true)
				task.delay(0.4, function()
					while holding and token == holdToken do
						setValue(value + step * direction, true)
						task.wait(0.06)
					end
				end)
			end)
			button.InputEnded:Connect(function(input)
				if isPress(input) then
					holding = false
				end
			end)
			button.MouseLeave:Connect(function()
				holding = false
			end)
		end
		bindRepeat(minusButton, - 1)
		bindRepeat(plusButton, 1)
		local Stepper = {}
		function Stepper:Set(newValue)
			setValue(newValue, true)
		end
		function Stepper:Get()
			return value
		end
		return Stepper
	end
