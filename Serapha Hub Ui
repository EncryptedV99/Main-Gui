local function create(className, properties)
	local instance = Instance.new(className)
	local parent = nil
	for property, value in pairs(properties) do
		if property == "Parent" then
			parent = value
		elseif type(value) == "table" and value.ThemeKey then
			instance:SetAttribute("Theme" .. property, value.ThemeKey)
			instance[property] = Colors[value.ThemeKey]
		else
			instance[property] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
