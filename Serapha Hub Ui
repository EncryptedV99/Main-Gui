local function attachKeybind(frame, headerHeight, rightOffset, defaultKey, onPress, onChanged)
	local key = defaultKey
	local listening = false
	local chip = create("TextButton", {
		Text = keyName(key),
		FontFace = currentFont,
		TextSize = 11,
		TextColor3 = Theme.SubText,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Field,
		BackgroundTransparency = 0.3,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, - rightOffset, 0, headerHeight / 2),
		Size = UDim2.fromOffset(36, 24),
		ZIndex = 3,
		Parent = frame,
	})
	corner(chip, 6)
	local outline = stroke(chip)
