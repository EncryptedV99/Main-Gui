		local function fitKeyButton(animate)
			local size = UDim2.fromOffset(math.max(44, textWidth(keyButton.Text, 12) + 22), 28)
			if animate then
				tween(keyButton, 0.15, {
					Size = size
				})
			else
				keyButton.Size = size
			end
		end
		fitKeyButton(false)
		local function setActive(state)
			active = state
			tweenTheme(indicator, 0.15, "BackgroundColor3", active and "Accent" or "Off")
		end
		local function updateDisplay()
			keyButton.Text = listening and "..." or keyName(key)
			focusOutline(outline, listening)
			tweenTheme(keyButton, 0.15, "TextColor3", listening and "Accent" or "Text")
			fitKeyButton(true)
		end
		local function setKey(newKey, shouldFire)
			key = newKey
			if active then
				setActive(false)
			end
			updateDisplay()
			if shouldFire then
				fire(config.Changed, key)
			end
		end
		local function startListening()
			if listening then
				return
			end
			listening = true
			bindingKey = true
			updateDisplay()
		end
		local function stopListening()
			listening = false
			updateDisplay()
			task.delay(0, function()
				bindingKey = false
			end)
		end
		local function matches(input)
			if key == nil then
				return false
			end
			if key.EnumType == Enum.KeyCode then
				return input.KeyCode == key
			end
			return input.UserInputType == key
		end
		local function flash()
			focusOutline(outline, true)
			tweenTheme(keyButton, 0.08, "TextColor3", "Accent")
			task.delay(0.18, function()
				if not listening then
					updateDisplay()
				end
			end)
		end
		rowButton.MouseButton1Click:Connect(startListening)
		keyButton.MouseButton1Click:Connect(startListening)
		connect(UserInputService.InputBegan, function(input, gameProcessed)
			if listening then
				local inputType = input.UserInputType
				if inputType == Enum.UserInputType.Keyboard then
					if input.KeyCode == Enum.KeyCode.Escape then
						stopListening()
					elseif input.KeyCode == Enum.KeyCode.Backspace then
						setKey(nil, true)
						stopListening()
					else
						setKey(input.KeyCode, true)
						stopListening()
					end
				elseif inputType == Enum.UserInputType.MouseButton2 or inputType == Enum.UserInputType.MouseButton3 then
					setKey(inputType, true)
					stopListening()
				elseif inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
					stopListening()
				end
				return
			end
			if gameProcessed or bindingKey or not matches(input) then
				return
			end
			if mode == "Toggle" then
				setActive(not active)
				flash()
				fire(config.Callback, active)
			elseif mode == "Hold" then
				setActive(true)
				flash()
				fire(config.Callback, true)
			else
				flash()
				fire(config.Callback)
			end
		end)
		connect(UserInputService.InputEnded, function(input)
			if mode == "Hold" and active and matches(input) then
				setActive(false)
				fire(config.Callback, false)
			end
		end)
		local Keybind = {}
		function Keybind:Set(newKey)
			setKey(newKey, true)
		end
		function Keybind:Get()
			return key
		end
		function Keybind:GetState()
			return active
		end
		return Keybind
	end
