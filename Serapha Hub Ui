		chip.Size = UDim2.fromOffset(math.max(36, textWidth(chip.Text, 11) + 18), 24)
	end
	local function update()
		chip.Text = listening and "..." or keyName(key)
		focusOutline(outline, listening)
		tweenTheme(chip, 0.15, "TextColor3", listening and "Accent" or "SubText")
		fit()
	end
	local function setKey(newKey)
		key = newKey
		update()
		fire(onChanged, key)
	end
	local function stopListening()
		listening = false
		update()
		task.delay(0, function()
			bindingKey = false
		end)
	end
	fit()
	chip.MouseButton1Click:Connect(function()
		if listening then
			return
		end
		listening = true
		bindingKey = true
		update()
	end)
	connect(UserInputService.InputBegan, function(input, gameProcessed)
		if listening then
			local inputType = input.UserInputType
			if inputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape then
					stopListening()
				elseif input.KeyCode == Enum.KeyCode.Backspace then
					setKey(nil)
					stopListening()
				else
					setKey(input.KeyCode)
					stopListening()
				end
			elseif inputType == Enum.UserInputType.MouseButton2 or inputType == Enum.UserInputType.MouseButton3 then
				setKey(inputType)
				stopListening()
			elseif inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
				stopListening()
			end
			return
		end
		if gameProcessed or bindingKey or key == nil then
			return
		end
		local matched
		if key.EnumType == Enum.KeyCode then
			matched = input.KeyCode == key
		else
			matched = input.UserInputType == key
		end
		if matched then
			focusOutline(outline, true)
			task.delay(0.18, function()
				if not listening then
					focusOutline(outline, false)
				end
			end)
			onPress()
		end
	end)
	local Binding = {}
	function Binding:Set(newKey)
		setKey(newKey)
	end
	function Binding:Get()
		return key
	end
	return Binding
end
