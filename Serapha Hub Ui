				subButton.MouseButton1Click:Connect(selectSubTab)
				subButton:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
					if activeSubTab == subTab then
						moveHighlight(subTab, false)
					end
				end)
				subButton:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
					if activeSubTab == subTab then
						moveHighlight(subTab, false)
					end
				end)
				table.insert(subTabs, subTab)
				if # subTabs == 1 then
					selectSubTab()
				end
				local SubTab = buildElements(subPage, function()
					return insetBox(subPage)
				end, {
					Path = tabTitle .. " / " .. (sectionConfig.Title or "") .. " / " .. (subConfig.Title or ""),
					Page = page,
					Register = register,
					Reveal = function()
						select()
						selectSubTab()
						openSection()
					end,
				})
				return SubTab
			end
			return MultiSection
		end
		local internal = {
			Page = page,
			Select = select,
			EndGroup = endGroup,
			GetParent = getParent,
		}
