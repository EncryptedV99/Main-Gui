			end,
		})
		Settings:Section({
			Title = "Appearance",
		})
		local themeRow, themeInner = paddedRow(internal.GetParent())
		headerBlock(themeInner, "Theme", "Pick the colors the hub uses", 1)
		local themeGrid = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = themeInner,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / 3, - 6, 0, 56),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = themeGrid,
		})
		local chipOutlines = {}
		local function markTheme(selectedName, immediate)
			for name, chipOutline in pairs(chipOutlines) do
				local isSelected = name == selectedName
				local key = isSelected and "Accent" or "Outline"
				if immediate then
					paint(chipOutline, "Color", key)
				else
					chipOutline:SetAttribute("ThemeColor", key)
				end
				chipOutline.Thickness = isSelected and 2 or 1
				chipOutline.Transparency = isSelected and 0 or 0.1
			end
		end
		for index, name in ipairs(THEME_ORDER) do
			local palette = Themes[name]
			local chip = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = palette.Background,
				LayoutOrder = index,
				Parent = themeGrid,
			})
			corner(chip)
			chipOutlines[name] = create("UIStroke", {
				Color = Theme.Outline,
				Thickness = 1,
				Transparency = 0.1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Parent = chip,
			})
			local swatch = create("Frame", {
				Size = UDim2.new(1, - 16, 0, 16),
				Position = UDim2.fromOffset(8, 8),
				BackgroundColor3 = palette.Item,
				Parent = chip,
			})
			corner(swatch, 4)
			local accentBar = create("Frame", {
				Size = UDim2.fromOffset(16, 6),
				Position = UDim2.new(0, 5, 0.5, - 3),
				BackgroundColor3 = palette.Accent,
				Parent = swatch,
			})
			pill(accentBar)
			local textBar = create("Frame", {
				Size = UDim2.new(1, - 32, 0, 4),
				Position = UDim2.new(0, 26, 0.5, - 2),
				BackgroundColor3 = palette.SubText,
				Parent = swatch,
			})
			pill(textBar)
			create("TextLabel", {
				Text = name,
				FontFace = currentFont,
				TextSize = 12,
				TextColor3 = palette.Text,
				BackgroundTransparency = 1,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Position = UDim2.fromOffset(9, 28),
				Size = UDim2.new(1, - 18, 0, 20),
				Parent = chip,
			})
			chip.MouseButton1Click:Connect(function()
				if name == currentThemeName then
					return
				end
				markTheme(name, false)
				applyTheme(name, true)
			end)
		end
		markTheme(currentThemeName, true)
		register({
			Title = "Theme",
			Description = "Pick the colors the hub uses",
			Frame = themeRow,
			Path = "Settings",
			Page = page,
			Reveal = internal.Select,
		})
		Settings:Dropdown({
			Title = "Font",
			Description = "Change the font used everywhere",
			Options = FONT_ORDER,
			Default = currentFontName,
			Callback = function(name)
				applyFont(name)
			end,
		})
	end
	if config.Home ~= false then
		buildHome()
	end
	if config.Settings ~= false then
		buildSettings()
	end
	if config.LoadNotification ~= false then
		task.delay(0.8, function()
			if not gui.Parent then
				return
			end
			local hint = "Use the minus button to tuck the hub away."
			if IS_TOUCH then
				hint = "Tap the minus button to tuck the hub away."
			elseif toggleKey then
				hint = "Press " .. readableKeyName(toggleKey) .. " to hide or show the hub."
			end
			Window:Notify({
				Title = titleText .. " loaded",
				Content = hint,
				Duration = 5,
			})
		end)
	end
	return Window
end
